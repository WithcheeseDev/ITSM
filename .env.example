# Copy to .env.local and fill in. Never commit .env.local.

# Browser-visible: AI implementation — "mock" (rule-based, default) or "azure"
VITE_AI_MODE=mock

# Dev proxy only (NO VITE_ prefix — these must never reach the browser bundle)
# Azure AI agent contract is still TBD; values below are placeholders.
AZURE_AI_ENDPOINT=https://example-agent.azurewebsites.net
AZURE_AI_PATH=/api/assist
AZURE_AI_KEY=replace-me
