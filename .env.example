# Copy to .env.local and fill in. Never commit .env.local.

# Browser-visible: AI implementation — "mock" (rule-based, default) or "azure"
VITE_AI_MODE=mock

# Vite middleware only (server/aiAssist.ts + server/ai/*, NO VITE_ prefix — these must never reach the browser bundle)
# AI SDK ToolLoopAgent; model chosen by AI_PROVIDER.
# AI_PROVIDER: azure | bedrock
AI_PROVIDER=azure
AI_MODEL=<deployment-or-model-id>

# AI_PROVIDER=azure — Azure AI Foundry Responses API: POST {AZURE_AI_ENDPOINT}/responses, AI_MODEL = deployment name
AZURE_AI_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
AZURE_AI_KEY=replace-me

# AI_PROVIDER=bedrock — Amazon Bedrock, AI_MODEL = model id
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
