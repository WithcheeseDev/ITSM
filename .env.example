# Copy to .env.local and fill in. Never commit .env.local.

# Browser-visible: AI implementation — "mock" (rule-based, default) or "azure"
VITE_AI_MODE=mock

# Vite middleware only (server/aiAssist.ts, NO VITE_ prefix — these must never reach the browser bundle)
# Azure AI Foundry Responses API: POST {AZURE_AI_ENDPOINT}/responses with the deployment name as model.
AZURE_AI_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
AZURE_AI_DEPLOYMENT=<deployment-name>
AZURE_AI_KEY=replace-me
